parameters:
    configDirectories:
        - %currentWorkingDirectory%/config

    scanDirectories:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/benchmarks
        - %currentWorkingDirectory%/database
        - %currentWorkingDirectory%/tests

    paths:
        - src
        - benchmarks
        - database
        - tests

    # Analyse against the supported PHP range (composer.json and the CI matrix)
    # rather than the PHP running PHPStan. Version-gated rules are evaluated at
    # the minimum, so features only valid on newer PHP, such as #[\Override] on
    # properties (PHP 8.5+), are not demanded of code that must load on PHP 8.3;
    # the trade-off is that PHP 8.4/8.5-only deprecation checks do not run.
    phpVersion:
        min: 80300
        max: 80599

    # The package supports Laravel 12 alongside 13, so its floor sits below the
    # 13.2 that introduced the model attributes. The legacy form is the only form
    # available until the floor moves, which dropping 12 would mean. The leading
    # wildcard is required because the config is staged outside the repository
    # when it runs.
    ignoreErrors:
        -
            identifier: sineMaculaLaravel.modelAttributeLaggingFloor
            paths:
                - '*/src/Models/*'
                - '*/tests/*'

    # Sessions are pruned through Laravel's model:prune, which calls the model's
    # pruneAll(). The package's own pruneAll() (PrunesSessions) also deletes
    # each session's proofs and provenance with it, which a query on the model
    # alone cannot do, so every session model may declare it.
    sineMaculaLaravel:
        modelHooks:
            - pruneAll
