<?xml version="1.0"?>
<ruleset name="Project">

    <!-- DisallowMixedTypeHint excluded: the package authenticates arbitrary
         consumer models, so identifier getters mirror Eloquent's mixed keys, and
         credential maps, JWT claims, and cache values are user-shaped by design.
         PHPStan still guards unsafe mixed access. -->
    <rule ref="SineMaculaLaravelPackage">
        <exclude name="SlevomatCodingStandard.TypeHints.DisallowMixedTypeHint"/>
    </rule>

    <file>src</file>
    <file>benchmarks</file>
    <file>database</file>
    <file>tests</file>

</ruleset>
